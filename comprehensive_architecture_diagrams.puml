@startuml ppo_algorithm_detail
!theme plain
skinparam backgroundColor #FFFFFF
skinparam roundcorner 15

start

:Initialize Policy π_θ;

while (Training Episode t ≤ T) is (continue)
  :Collect Experience;
  note right : Sample actions from π_θ(s)\nObserve rewards R_t\nStore transitions
  
  :Compute Advantages;
  note right : GAE: Â_t = Σ(γλ)^l δ_{t+l}\nwhere δ = R + γV(s') - V(s)
  
  :Update Policy;
  note right : PPO Loss:\nL = E[min(r_t(θ)Â_t, clip(r_t, 1-ε, 1+ε)Â_t)]
  
  :Value Function Update;
  note right : L_V = 1/2(V_θ(s) - R_total)^2
  
  :Entropy Regularization;
  note right : L_ent = -β_ent Σ π(a|s) log π(a|s)
  
  :Total Loss = L_PPO + 0.5×L_V + 0.01×L_ent;
  
  :Gradient Update: θ ← θ - α∇L_total;
endwhile (complete)

:Evaluate Final Policy;

stop

floating note right : Clipping parameter ε = 0.2\nGAE parameter λ = 0.95\nEntropy coefficient β_ent = 0.01
@enduml

