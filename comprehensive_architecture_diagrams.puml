@startuml cyberwheel_architecture_overview
!theme plain
skinparam backgroundColor #FFFFFF
skinparam roundcorner 20

package "Cyberwheel Framework Architecture" {
  package "Multi-Agent Environment" as env #E3F2FD {
    rectangle "Network Graph G(V,E)" as network {
      node "Hosts (H)" as hosts #4CAF50
      node "Subnets (S)" as subnets #2196F3
      node "Routers (R)" as routers #FF9800
      node "Decoys (D)" as decoys #9C27B0
      hosts -- subnets
      subnets -- routers
      routers -- decoys
    }
    
    rectangle "MITRE ATT&CK\n295 Techniques" as mitre #FFCDD2
    rectangle "Detection System" as detection #C8E6C9
    
    network --> mitre
    network --> detection
  }

  package "Agent Framework" as agents #FFF3E0 {
    rectangle "Red Agent (Attacker)" as red #FFEBEE {
      rectangle "State Space: 7×|discovered hosts|" as red_state
      rectangle "Action Space: techniques × hosts" as red_action
      rectangle "Kill Chain Progression" as killchain
      red_state --> red_action
      red_action --> killchain
    }
    
    rectangle "Blue Agent (Defender)" as blue #E3F2FD {
      rectangle "State Space: 2|H| + 2" as blue_state
      rectangle "Action Space: 2|S||D| + |H| + 1" as blue_action  
      rectangle "Deception Strategy" as deception
      blue_state --> blue_action
      blue_action --> deception
    }
    
    red <--> blue : Adversarial Interaction
  }

  package "Learning Framework" as learning #F3E5F5 {
    rectangle "PPO Algorithm" as ppo #E1BEE7
    rectangle "Multi-Seed Validation" as validation #BA68C8
    ppo --> validation
  }

  env --> agents
  agents --> learning
  learning --> env : Policy Updates
}

note right of env : Simulation scales\n15 to 10,000 hosts
note bottom of ppo : Current implemented learning algorithm
@enduml

