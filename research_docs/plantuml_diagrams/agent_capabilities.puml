@startuml agent_capabilities
!define RECTANGLE class

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10

package "Red Agent Action Space" as RedSpace #FFE6E6 {
  rectangle "Phase 1: Discovery" as Phase1 #FFCCCC {
    + Network Scanning
    + Service Enumeration
    + Host Discovery
    + Reconnaissance
  }
  
  rectangle "Phase 2: Initial Access" as Phase2 #FFCCCC {
    + Exploit Vulnerabilities
    + Credential Access
    + Initial Foothold
    + Persistence
  }
  
  rectangle "Phase 3: Lateral Movement" as Phase3 #FFCCCC {
    + Remote Access
    + Privilege Escalation
    + Internal Reconnaissance
    + Account Discovery
  }
  
  rectangle "Phase 4: Impact" as Phase4 #FFCCCC {
    + Data Exfiltration
    + System Disruption
    + Resource Hijacking
    + Service Stop
  }
}

package "Blue Agent Action Space" as BlueSpace #E6FFE6 {
  rectangle "Deploy Decoy" as Deploy #CCFFCC {
    + Select Host h ∈ H
    + Create Deception
    + Configure Services
    + Monitor Interactions
  }
  
  rectangle "Remove Decoy" as Remove #CCFFCC {
    + Target Host h ∈ H
    + Cleanup Resources
    + Update Network State
    + Resource Management
  }
  
  rectangle "No Operation" as NoOp #CCFFCC {
    + Maintain Current State
    + Observe Network
    + Passive Monitoring
    + Information Gathering
  }
}

rectangle "State Observation" as StateObs #E6F3FF {
  + s_t^(b) ∈ ℝ^(2|H|+2)
  + Alert History
  + Network Topology
  + Decoy Status
}

RedSpace <--> BlueSpace : Adversarial\nInteraction

BlueSpace --> StateObs : Observation\nSpace

note bottom : |A^(r)| = 295 MITRE ATT&CK techniques\n|A^(b)| = 2|H| + 1 strategic actions\nAsymmetric but balanced through reward design

@enduml
