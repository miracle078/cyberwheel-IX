@startuml environment_interaction_new
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 10

skinparam component {
  BackgroundColor #F8F8F8
  BorderColor #333333
  BorderThickness 2
}

component [**Red Agent**\nπ^(r) fixed\nMITRE ATT&CK] as RedAgent #FFE6E6
component [**Environment E**\nHosts N_t\nDecoys D_t\nNetwork State] as Environment #E6FFE6
component [**Blue Agent**\nPPO π_θ\nAdaptive Defense] as BlueAgent #E6F3FF

RedAgent --> Environment : Attacks
Environment --> BlueAgent : Observations
BlueAgent --> Environment : Defense Actions\n(Deploy/Remove Decoys)

component [**Detection Signals**\nReward Terms\nShaping Signals] as Signals #F0F0F0

Environment --> Signals : Detection Events
Signals --> BlueAgent : Reward Feedback

note bottom of Signals : Detection/Compromise Signals\nFeed reward computation

@enduml
