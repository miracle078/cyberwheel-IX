@startuml observation_vector_enhanced
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 9

skinparam component {
  BackgroundColor #F8F8F8
  BorderColor #333333
  BorderThickness 2
}

package "Blue Agent Observation Vector $O_t \in \mathbb{R}^{2|H|+2}$" {
  package "Current Alerts $|H|$ dimensions" {
    component [**Host 1 Alert**\n$A_t^{(1)} \in \{0,1\}$\nImmediate threat] as Current1 #FFE6E6
    component [**Host 2 Alert**\n$A_t^{(2)} \in \{0,1\}$\nImmediate threat] as Current2 #FFE6E6
    component [**...**] as CurrentDots #F0F0F0
    component [**Host N Alert**\n$A_t^{(N)} \in \{0,1\}$\nImmediate threat] as CurrentN #FFE6E6
  }

  package "Historical Alerts $|H|$ dimensions" {
    component [**Host 1 History**\n$H_t^{(1)} \in \{0,1\}$\nPattern learning] as History1 #E6F3FF
    component [**Host 2 History**\n$H_t^{(2)} \in \{0,1\}$\nPattern learning] as History2 #E6F3FF
    component [**...**] as HistoryDots #F0F0F0
    component [**Host N History**\n$H_t^{(N)} \in \{0,1\}$\nPattern learning] as HistoryN #E6F3FF
  }

  package "Metadata 2 dimensions" {
    component [**Headstart Flag**\n$F_t \in \{-1,1\}$\n$-1$: Normal, $1$: Headstart] as Headstart #E6FFE6
    component [**Decoy Count**\n$D_t \in \mathbb{N}$\nActive decoys] as DecoyCount #FFF2CC
  }
}

note right : Total Dimensions: $2|H| + 2$\n$O_t = [A_t^{(1)},\dots,A_t^{(N)}, H_t^{(1)},\dots,H_t^{(N)}, F_t, D_t]$

@enduml
