@startuml configuration_hierarchy_new
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 9

skinparam component {
  BackgroundColor #F8F8F8
  BorderColor #333333
  BorderThickness 2
}

component [**Cyberwheel Config**\nYAML Hierarchy\nMaster Configuration] as Root #F0F0F0

component [**Environment Config**\nNetwork topology\nHost configurations\nAttack patterns] as Environment #E6FFE6

component [**Agent Config**\nPPO parameters\nLearning rates\nNetwork architecture] as Agent #E6F3FF

component [**Mathematical Mapping**\nγ, λ, ε values\nFormal verification\nAlgorithm parameters] as Math #FFF2CC

component [**Experimental Controls**\nSeeds: {1,42,123...}\nFixed red policy\nUnified logging] as Experimental #FFE6E6

component [**Implementation Verification**\nCode-config mapping\nParameter validation\nBaseline consistency] as Implementation #E6F3FF

Root --> Environment : Network Setup
Root --> Agent : Learning Config
Root --> Math : Algorithm Params

Environment --> Experimental : Validation
Agent --> Implementation : Verification
Math --> Implementation : Formal Check

note right of Experimental : Reproducibility Controls
note right of Implementation : Configuration Validation

@enduml
