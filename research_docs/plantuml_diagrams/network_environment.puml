@startuml network_environment
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11

package "Cyberwheel Network Environment" {
  package "DMZ Subnet" {
    node "Web Server" as Web #FFE6E6
    node "Mail Server" as Mail #FFE6E6
    node "DNS Server" as DNS #FFE6E6
    node "Decoy Web" as DecoyWeb #E6F3FF
  }
  
  package "Internal Subnet 1" {
    node "Workstation 1" as WS1 #FFE6E6
    node "Workstation 2" as WS2 #FFE6E6
    node "File Server" as FileServ #FFE6E6
    node "Decoy DB" as DecoyDB #E6F3FF
  }
  
  package "Internal Subnet 2" {
    node "Database" as DB #FFE6E6
    node "App Server" as AppServ #FFE6E6
    node "Backup Server" as Backup #FFE6E6
    node "Decoy File" as DecoyFile #E6F3FF
  }
  
  component [**Red Agent**\nMITRE ATT&CK\nAttack Techniques] as RedAgent #FFCCCC
  component [**Blue Agent**\nPPO Defense\nDecoy Deployment] as BlueAgent #CCE6FF
}

RedAgent --> Web : Attack
RedAgent --> WS1 : Lateral Movement
BlueAgent --> DecoyWeb : Deploy Decoy
BlueAgent --> DecoyDB : Monitor

note right of RedAgent : 295 attack techniques\nacross 4 phases
note left of BlueAgent : Strategic decoy\nplacement learning

@enduml
  + Network Scanning
  + Lateral Movement
  + Data Exfiltration
}

rectangle "Blue Agent\n(Defender)" as BlueAgent #99FF99 {
  + Decoy Deployment
  + Decoy Removal
  + Network Monitoring
  + Strategic Defense
}

' Network connections
DMZRouter --> Internal1
DMZRouter --> Internal2

' Agent interactions
RedAgent ..> DMZ : Attack
RedAgent ..> Internal1 : Lateral Movement
RedAgent ..> Internal2 : Compromise Attempt

BlueAgent ..> DecoyDMZ : Deploy/Remove
BlueAgent ..> DecoyInt1 : Deploy/Remove
BlueAgent ..> DecoyInt2 : Deploy/Remove

note bottom of DMZ : Real hosts are potential targets\nDecoy hosts provide deception\nAgents interact through environment

@enduml
